# Runtime environment: development | test | production
NODE_ENV=development

# Privacy provider: deterministic (local dev/test/demo) | google (Google Cloud SDP)
SDP_PROVIDER=deterministic

# Gemini API key: required for AI analysis pipeline
GEMINI_API_KEY=

# Google Cloud Project: required only when SDP_PROVIDER=google
GOOGLE_CLOUD_PROJECT=

# PostgreSQL database URL (optional for local development, defaults to SQLite :memory:)
# For local Docker Compose setup:
# LOTUSLEARN_DATABASE_URL=postgresql://lotuslearn:lotuslearn_dev_password@localhost:5432/lotuslearn_dev
LOTUSLEARN_DATABASE_URL=
