{
    "name":  "lotuslearn",
    "private":  true,
    "version":  "0.1.0",
    "type":  "module",
    "packageManager":  "npm@11.16.0",
    "engines":  {
                    "node":  "\u003e=22.0.0"
                },
    "scripts":  {
                    "dev":  "node server.js",
                    "build":  "vite build \u0026\u0026 esbuild server.js --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server.js",
                    "start":  "node dist/server.js",
                    "preview":  "vite preview",
                    "clean":  "node scripts/clean.js",
                    "test":  "node --test server/services/pipelineRegression.test.js server/services/pythonObserverAdapter.test.js src/context/ThemeContext.test.js server/services/pythonDiagnosisAdapter.test.js",
                    "test:python":  "pytest pipelines/tests",
                    "lint":  "oxlint",
                    "lint:python":  "ruff check pipelines",
                    "fixtures:reliability":  "python scripts/export_reliability_fixtures.py",
                    "fixtures:verify":  "python scripts/verify_reliability_fixtures.py",
                    "pipeline:run":  "node scripts/run_pipeline_smoke.js",
                    "pipeline:run:postgres":  "node scripts/run_pipeline_postgres_smoke.js",
                    "dbt:parse":  "dbt parse --project-dir analytics --profiles-dir analytics",
                    "dbt:test:unit":  "dbt test --project-dir analytics --profiles-dir analytics --select test_type:unit",
                    "dbt:build":  "dbt build --project-dir analytics --profiles-dir analytics",
                    "dbt:docs":  "dbt docs generate --project-dir analytics --profiles-dir analytics",
                    "verify:zero-typescript":  "node scripts/verify_zero_typescript.js"
                },
    "dependencies":  {
                         "@google/genai":  "^2.4.0",
                         "@tailwindcss/vite":  "^4.3.3",
                         "@vitejs/plugin-react":  "^6.1.1",
                         "dotenv":  "^17.2.3",
                         "express":  "^4.21.2",
                         "google-auth-library":  "^11.3.1",
                         "lucide-react":  "^0.546.0",
                         "motion":  "^12.23.24",
                         "react":  "^19.0.1",
                         "react-dom":  "^19.0.1",
                         "vite":  "^8.3.0",
                         "zod":  "^4.6.5"
                     },
    "devDependencies":  {
                            "autoprefixer":  "^10.4.21",
                            "esbuild":  "^0.28.0",
                            "oxlint":  "^1.89.0",
                            "tailwindcss":  "^4.3.3"
                        }
}
